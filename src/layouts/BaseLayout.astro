---
import { site } from "../lib/site";
import { shareMetadata } from "../lib/share.mjs";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "about" | "update";
  published?: string;
}

const { title, description = site.description, current, published } = Astro.props;
const meta = shareMetadata({
  siteName: site.name,
  title,
  description,
  canonical: Astro.url.href,
  current,
  published,
});
const { pageTitle } = meta;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={meta.canonical} />
    <meta property="og:type" content={meta.type} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.pageTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.pageTitle} />
    <meta name="twitter:description" content={meta.description} />
    {
      meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1ece2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161310" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var theme = "light";
        try {
          var stored = localStorage.getItem("dd-theme");
          if (stored === "light" || stored === "dark") theme = stored;
          else if (window.matchMedia("(prefers-color-scheme: dark)").matches) theme = "dark";
        } catch (e) {
          try {
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) theme = "dark";
          } catch (e2) {
            /* localStorage and matchMedia may be unavailable */
          }
        }

        document.documentElement.dataset.theme = theme;

        var color = theme === "dark" ? "#161310" : "#f1ece2";
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = metas.length - 1; i >= 0; i--) {
          if (i === 0) {
            metas[i].setAttribute("content", color);
            metas[i].removeAttribute("media");
          } else {
            metas[i].parentNode.removeChild(metas[i]);
          }
        }

        var label = "Switch to " + (theme === "dark" ? "light" : "dark") + " color scheme";
        var pressed = theme === "dark" ? "true" : "false";
        function syncToggle() {
          var buttons = document.querySelectorAll("[data-theme-toggle]");
          for (var n = 0; n < buttons.length; n++) {
            buttons[n].setAttribute("aria-label", label);
            if (buttons[n].hasAttribute("aria-pressed")) {
              buttons[n].setAttribute("aria-pressed", pressed);
            }
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", syncToggle);
        } else {
          syncToggle();
        }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" class="site-main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
